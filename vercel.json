{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/sales-page-EN.html" },
    { "source": "/en", "destination": "/sales-page-EN.html" },
    { "source": "/es", "destination": "/sales-page-ES.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
