{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/sales-page-EN" },
    { "source": "/en", "destination": "/sales-page-EN" },
    { "source": "/es", "destination": "/sales-page-ES" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
